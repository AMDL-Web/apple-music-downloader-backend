# The build context is the repository root (docker build -f
# deploy/server/Dockerfile .). It needs only the Go sources, the console's
# static files, the example configs and the entrypoint; everything else is
# excluded so runtime data, keys or local artifacts never end up in the image.
# The classic builder reads this file only from the context root.
.git
.github
.claude
.worktrees
.idea
.vscode
.DS_Store

# Local runtime data, tests and docs.
data/
test/
docs/

# Keys never go into the image; mount them as a volume when needed.
keys/
*.p8

# Local build output and coverage files.
/bin
*.out
coverage.txt

# Local/runtime configs; the image keeps only config.example.yaml and
# hooks.example.yaml.
*.local.yaml
configs/config.yaml
configs/hooks.yaml
# The old two-file runtime config and the one-off backups left by merging it.
configs/runtime.yaml
configs/runtime.yaml.pre-merge.bak*
configs/config.yaml.pre-split.bak

# Release scripts and other tools unrelated to the image.
tools/

# Deployment files other than the entrypoint. This also keeps out the configs/
# and data/ that compose creates beside itself when run from deploy/ in a clone.
deploy/
!deploy/server/docker-entrypoint.sh
.dockerignore
