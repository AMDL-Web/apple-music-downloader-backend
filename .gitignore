.DS_Store
.worktrees/
.claude/worktrees/
# Personal Claude Code settings; the shared hooks live in .claude/settings.json.
.claude/settings.local.json

# Runtime data produced by the rewritten backend.
data/
# make build output.
/bin/
/dist/
# make desktop and make desktop-web output.
/apps/desktop/build/
# node apps/site/build.mjs output.
/apps/site/dist/

test/

# docs/ holds the reference documentation the README links to, so it is
# tracked. Agent plans and design scratch stay local.
/docs/superpowers/

*.p8
keys/

# Editor / IDE settings.
.idea/
.vscode/

# Go test & coverage artifacts.
*.out
coverage.txt

*.local.yaml
# Live config file: bootstrapped from the example file on first start and
# rewritten by PUT /api/v1/config. It is not tracked.
configs/config.yaml
# Legacy split runtime file and the one-time archive created after merging it.
configs/runtime.yaml
configs/runtime.yaml.pre-merge.bak*
# Backup created by the previous single-to-split migration may still contain
# runtime secrets in upgraded workspaces.
configs/config.yaml.pre-split.bak
# What deploy/docker-compose.yml creates beside itself when run from a clone
# (data/ above already matches at any depth).
/deploy/configs/
